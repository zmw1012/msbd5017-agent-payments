# Testnet / mock only. Do not use real funds, production credentials, or customer data.
# Copy this file to .env on your machine (gitignored). Never commit .env.
# Leave values empty or use safe placeholders — never put real private keys here.

# HTTP URL of a Base Sepolia JSON-RPC provider
RPC_URL=

# Test wallet private key for Base Sepolia faucet funds only (never a mainnet key)
PRIVATE_KEY=

# Contract address of the test USDC (or equivalent test asset) on Base Sepolia
TEST_USDC_ADDRESS=

# Base URL of our single mock Merchant API
MERCHANT_API_URL=

# Network label used by tooling
NETWORK=base-sepolia
